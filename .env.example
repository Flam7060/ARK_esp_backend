# Скопируй в .env и заполни. Читается docker-compose (services: backend_python).
APP_SECRET_KEY=change-me-to-a-real-secret
APP_DEBUG=false

DB_NAME=ark
DB_USER=ark
DB_PASSWORD=change-me-to-a-real-password

# Перец для argon2id (admin/account password_hash) — сгенерируй свой:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Смена перца делает невалидными ВСЕ существующие хеши паролей.
SECURITY_PEPPER=change-me-to-a-real-random-pepper

# Опционально — порты, проброшенные наружу с хоста. Не заданы — берутся
# дефолты (8000/8081) из docker-compose.yml.
# BACKEND_PYTHON_PORT=8000
# BACKEND_GO_PORT=8081
# BACKEND_GO_QUIC_PORT=8443

# QUIC-транспорт backend_go (kopt::Http3Publisher со стороны клиента).
# Оба пустые -- cmd/relay каждый рестарт генерирует эфемерный
# самоподписанный сертификат заново (см. его собственное предупреждение в
# логе) -- никогда не годится для прода: клиентам не на что опереться между
# рестартами. deploy/deploy.sh генерирует пару сам при первом запуске.
# RELAY_TLS_CERT_FILE=/keys/relay_cert.pem
# RELAY_TLS_KEY_FILE=/keys/relay_key.pem
